+// VR-only shader tail (vr/vr.h): four dots against c201..c204 carry the mono clip position to
+// the eye's clip position. Outside VR clip_matrix() is the identity, so the shader is identical.
+std::string vr_clip_tail()
+{
+    return "  o.pos = float4(dot(o.pos, vrRow0), dot(o.pos, vrRow1), dot(o.pos, vrRow2), dot(o.pos, vrRow3));\n";
+}
